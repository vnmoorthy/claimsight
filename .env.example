# Claude Agent Starter — Environment Variables
# Copy this file to .env and fill in real values

# ── Option 1: Official Anthropic direct connection (recommended) ──
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_BASE_URL=                   # Optional, leave empty for default
ANTHROPIC_CUSTOM_HEADERS=             # Optional, custom request headers

# ── Option 2: AI Gateway (must be compatible with Anthropic Messages API) ──
AI_GATEWAY_API_KEY=your_gateway_key      # Required
AI_GATEWAY_BASE_URL=https://your-gateway.example.com  # Required
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash          # Optional
AI_GATEWAY_SMALL_MODEL=@makers/deepseek-v4-flash     # Optional

# ── General config ──
CLAUDE_MODEL=claude-sonnet-4-6        # Optional, override default model
ANTHROPIC_SMALL_FAST_MODEL=           # Optional, override CLI internal small model

# ── Web Search Agent (optional) ──────────────────────────────────────────────
# Tencent Cloud Web Search API. Get a key at https://pages.edgeone.ai/document/sandbox-network-search-tool
WSA_API_KEY=sk-xxx                    # Web search API key

# ══════════════════════════════════════════════════════════════════════════════
# ClaimSight — after-sales claims agent (SPEC §9)
# ══════════════════════════════════════════════════════════════════════════════

# ── Agent mode ──
AGENT_MODE=                                        # llm | deterministic — empty = auto (deterministic when no AI_GATEWAY_API_KEY / ANTHROPIC_API_KEY)

# ── Model (Makers AI Gateway; Anthropic-compatible) ──
# AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL are declared above (auto-provisioned on deploy).
# Override the base URL to https://ai-gateway.edgeone.link/v1 for Makers Models.
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-pro          # claims agent default; SDK falls back to AI_GATEWAY_FALLBACK_MODEL
AI_GATEWAY_FALLBACK_MODEL=@makers/kimi-k2.6        # Optional

# ── Memories.ai Video Datalake (server-side only; never sent to the browser) ──
MEMORIES_API_KEY=                                  # sk-mai-… ; leave empty (or set MEMORIES_STUB=1) to use data/stubs/*.json
MEMORIES_BASE=https://api.memories.ai/serve/datalake/v1
MEMORIES_CLAIMS_COLLECTION=                        # col_… collection that evidence videos are indexed into
MEMORIES_CATALOG_COLLECTION=                       # col_… optional product-catalog collection
MEMORIES_STUB=1                                    # 1 = canned Memories.ai responses (no network); unset for live calls
MEMORIES_STUB_INDEX_SECONDS=6                      # Optional: how long a stubbed upload takes to "index"

# ── Policy / fraud ──
FRAUD_SIMILARITY_THRESHOLD=0.80                    # frame-embedding score at/above which a match counts (P5)

# ── Service wiring ──
SELF_BASE_URL=http://localhost:8088                # Where the agent reaches /refund, /replacement, /claims-record, /agentx-emit
PUBLIC_UI_URL=http://localhost:5173                # Public UI origin used in Slack escalations: <PUBLIC_UI_URL>/#desk?claim=<claim_id>
UI_BASE_URL=                                       # Optional: public UI origin used in Slack links (<UI>/desk); legacy fallback for PUBLIC_UI_URL
SLACK_WEBHOOK_URL=                                 # Optional: incoming webhook for escalations
AGENTX_OTLP_URL=http://localhost:4700/api/v1/otel/v1/traces   # OTLP/HTTP JSON traces endpoint (AgentX)
AGENTX_API_KEY=                                    # Sent as x-api-key; traces are skipped when both AGENTX_* are unset
ADMIN_TOKEN=                                       # Protects POST /seed and POST /claims-record via x-admin-token (open when unset)

# ── Storage (claims / orders / ledger) ──
STORAGE=auto                                       # auto | blob | kv | memory — auto tries Blob (@edgeone/pages-blob) then falls back to memory
CLAIMS_BLOB_STORE=claimsight                       # Blob store name (getStore({ name, consistency: "strong" }))
CLAIMS_KV=CLAIMS_KV                                # Name of a console-bound KV global, if the runtime exposes one
PAGES_BLOB_PROJECT_ID=                             # Optional: external Blob access from local scripts
PAGES_BLOB_TOKEN=                                  # Optional: external Blob access from local scripts

# ── VeloDB (optional analytics, see velodb/) ──
VELODB_HOST=
VELODB_PORT=9030
VELODB_USER=
VELODB_PASSWORD=
VELODB_DB=

# ── AWS (optional) ─────────────────────────────────────────────────────────
AWS_S3_BUCKET=                                     # set to enable the S3 evidence archive (see aws/README.md)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=                                   # optional S3-compatible endpoint (MinIO/R2), path-style
AWS_S3_PREFIX=claims
